rules_version = '2';

// GENERADO por scripts/gen-firestore-rules.mjs desde src/qa-lab/report/schema.js. NO editar a mano: editar el generador
// o LIMITS en schema.js y volver a correr `node scripts/gen-firestore-rules.mjs` (un test verifica que esten sincronizados).
//
// QA Lab: el cliente solo puede CREAR intentos. Lectura, update y delete denegados (los resultados se
// ven en la consola de Firebase). Alineado con src/qa-lab/report/schema.js.
// Los findings no se validan por elemento (ni con funciones ni en linea: ambas variantes excedieron el presupuesto de
// evaluacion en produccion). Se guardan como `findingsJson` (string <= 151000, peor caso de 20 findings) y
// `findingsCount` (0..20); el cliente valida cada finding antes de enviar. Solo hay una funcion (validAttempt).
service cloud.firestore {
  match /databases/{database}/documents {

    function validAttempt(d) {
      return d.keys().hasOnly(['seed', 'level', 'lang', 'candidate', 'startedAt', 'finishedAt', 'durationMs', 'findingsJson', 'findingsCount', 'score', 'solutionViewed', 'labVersion', 'userAgent', 'createdAt'])
        && d.keys().hasAll(['seed', 'level', 'lang', 'candidate', 'startedAt', 'finishedAt', 'durationMs', 'findingsJson', 'findingsCount', 'score', 'solutionViewed', 'labVersion', 'userAgent', 'createdAt'])
        && d.seed is string && d.seed.size() > 0 && d.seed.size() <= 100
        && d.level in ['junior', 'semi', 'senior']
        && d.lang in ['es', 'en']
        && d.candidate is map
        && d.candidate.keys().hasOnly(['name', 'email'])
        && d.candidate.name is string && d.candidate.name.size() > 0 && d.candidate.name.size() <= 80
        && d.candidate.email is string && d.candidate.email.size() <= 120
        && d.candidate.email.matches('^[^@ \\t\\r\\n]+@[^@ \\t\\r\\n]+\\.[^@ \\t\\r\\n]+$')
        && d.startedAt is int && d.startedAt > 0
        && d.finishedAt is int && d.finishedAt >= d.startedAt && d.finishedAt <= request.time.toMillis() + 300000
        && d.durationMs is int && d.durationMs == d.finishedAt - d.startedAt
        && d.findingsJson is string && d.findingsJson.size() <= 151000
        && d.findingsCount is int && d.findingsCount >= 0 && d.findingsCount <= 20
        && d.score is map
        && d.score.keys().hasOnly(['value', 'hits', 'halfHits', 'falsePositives', 'missed'])
        && d.score.value is int && d.score.value >= 0 && d.score.value <= 100
        && d.score.hits is int && d.score.hits >= 0 && d.score.hits <= 20
        && d.score.halfHits is int && d.score.halfHits >= 0 && d.score.halfHits <= 20
        && d.score.falsePositives is int && d.score.falsePositives >= 0 && d.score.falsePositives <= 20
        && d.score.missed is int && d.score.missed >= 0 && d.score.missed <= 36
        && d.createdAt == request.time
        && d.solutionViewed is bool
        && d.labVersion is string && d.labVersion.size() > 0 && d.labVersion.size() <= 20
        && d.userAgent is string && d.userAgent.size() <= 200;
    }

    match /qa_lab_attempts/{id} {
      allow create: if validAttempt(request.resource.data);
      allow get, list, update, delete: if false;
    }

    // Todo lo demas, denegado.
    match /{document=**} {
      allow get, list, create, update, delete: if false;
    }
  }
}
