rules_version = '2';

// GENERADO por scripts/gen-firestore-rules.mjs desde src/qa-lab/report/schema.js. NO editar a mano: editar el generador
// o LIMITS en schema.js y volver a correr `node scripts/gen-firestore-rules.mjs` (un test verifica que esten sincronizados).
//
// QA Lab: el cliente solo puede CREAR intentos. Lectura, update y delete denegados (los resultados se
// ven en la consola de Firebase). Alineado con src/qa-lab/report/schema.js.
// Las reglas no iteran listas: `findings` se acota a 20 y cada indice 0..19 se valida EN LINEA.
// Limite que importa: LLAMADAS A FUNCIONES por evaluacion (medido en produccion: con una funcion por finding, 4 findings
// ya daban permission-denied). Por eso aqui hay UNA sola funcion (validAttempt) y candidate, score y los findings van en linea.
// Segundo limite: ~1000 expresiones por evaluacion; probar playground-20.json (20 findings completos) en el Rules Playground.
service cloud.firestore {
  match /databases/{database}/documents {

    function validAttempt(d) {
      return d.keys().hasOnly(['seed', 'level', 'lang', 'candidate', 'startedAt', 'finishedAt', 'durationMs', 'findings', 'score', 'solutionViewed', 'labVersion', 'userAgent', 'createdAt'])
        && d.keys().hasAll(['seed', 'level', 'lang', 'candidate', 'startedAt', 'finishedAt', 'durationMs', 'findings', 'score', 'solutionViewed', 'labVersion', 'userAgent', 'createdAt'])
        && d.seed is string && d.seed.size() > 0 && d.seed.size() <= 100
        && d.level in ['junior', 'semi', 'senior']
        && d.lang in ['es', 'en']
        && d.candidate is map
        && d.candidate.keys().hasOnly(['name', 'email'])
        && d.candidate.name is string && d.candidate.name.size() > 0 && d.candidate.name.size() <= 80
        && d.candidate.email is string && d.candidate.email.size() <= 120
        && d.candidate.email.matches('^[^@ \\t\\r\\n]+@[^@ \\t\\r\\n]+\\.[^@ \\t\\r\\n]+$')
        && d.startedAt is int && d.startedAt > 0
        && d.finishedAt is int && d.finishedAt >= d.startedAt && d.finishedAt <= request.time.toMillis() + 300000
        && d.durationMs is int && d.durationMs == d.finishedAt - d.startedAt
        && d.findings is list && d.findings.size() <= 20
        && (d.findings.size() < 1 || (d.findings[0] is map
          && d.findings[0].keys().hasOnly(['id', 'page', 'description', 'severity', 'guessedBugId', 'guessedCategory'])
          && d.findings[0].id is string && d.findings[0].id.size() > 0 && d.findings[0].id.size() <= 40
          && d.findings[0].page is string && d.findings[0].page.size() <= 100
          && d.findings[0].description is string && d.findings[0].description.size() > 0 && d.findings[0].description.size() <= 1000
          && d.findings[0].severity in ['low', 'medium', 'high', 'critical']
          && (d.findings[0].get('guessedBugId', null) == null || (d.findings[0].get('guessedBugId', null) is string && d.findings[0].get('guessedBugId', null).size() > 0 && d.findings[0].get('guessedBugId', null).size() <= 60))
          && (d.findings[0].get('guessedCategory', null) == null || (d.findings[0].get('guessedCategory', null) is string && d.findings[0].get('guessedCategory', null).size() > 0 && d.findings[0].get('guessedCategory', null).size() <= 30))))
        && (d.findings.size() < 2 || (d.findings[1] is map
          && d.findings[1].keys().hasOnly(['id', 'page', 'description', 'severity', 'guessedBugId', 'guessedCategory'])
          && d.findings[1].id is string && d.findings[1].id.size() > 0 && d.findings[1].id.size() <= 40
          && d.findings[1].page is string && d.findings[1].page.size() <= 100
          && d.findings[1].description is string && d.findings[1].description.size() > 0 && d.findings[1].description.size() <= 1000
