# Config web PUBLICA de Firebase (no es secreta; sin claves de servidor). Copiar a .env.local en la raiz.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=multiverse-portfolio.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=multiverse-portfolio
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA v3). Sin clave, App Check no se inicializa (dev/tests).
VITE_RECAPTCHA_SITE_KEY=
# Solo dev: token de depuracion de App Check (consola de Firebase > App Check > Apps > Administrar tokens de depuracion).
VITE_APPCHECK_DEBUG_TOKEN=
