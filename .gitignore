# Cache local de firebase-tools: guarda hashes del ultimo deploy para subir solo
# los archivos cambiados. Es estado por-maquina, no configuracion del proyecto
# (esa vive en firebase.json y .firebaserc, que SI se commitean).
.firebase/

# Documentos personales fuera del repo (excepto la copia pública del CV servida por Vite)
Profile.pdf
!public/Profile.pdf

# Fotos de referencia para pixelforge (privacy gate Phase 4 D4-02)
# Vite las sirve en dev local pero NO deben commitearse al repo.
# Phase 6 deploy gate añadirá exclusión en firebase.json para que no se deployen.
public/references/

# Artefactos de RESULTADOS de arneses de verificación CDP (TASK-011 ronda 2 de
# review): el INSTRUMENTO (scripts/verify-ch5-broadcast.mjs, verify-ch3-*.mjs)
# SÍ se commitea — sin eso su verde no sería auditable ni reproducible
# (.planning/LECCIONES-TECNICAS.md §6). Pero el JSON de resultados que escribe
# cada corrida es un snapshot de un punto en el tiempo que queda desactualizado
# en la corrida siguiente — commitearlo generaría diff-noise en cada re-run sin
# aportar auditabilidad real (la evidencia auditable es la salida de consola
# capturada verbatim en el hand-off/PR, igual que ya hace verify-ch3-*.mjs, que
# ni siquiera persiste un archivo). Ver decisión en el hand-off de TASK-011.
.planning/*-verify-results*.json
# TASK-041 ronda 2: mismo criterio, mismo motivo — el instrumento
# (scripts/verify-content-reachable.mjs) se commitea, sus JSON de resultados no.
.planning/task041-content-reachable-*.json
